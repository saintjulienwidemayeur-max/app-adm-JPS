"use server";

import { revalidatePath } from "next/cache";
import { createClient } from "@/lib/supabase/server";
import { calcPricing } from "@/lib/pricing";

export type ScanResult =
  | { kind: "new"; tracking: string }
  | { kind: "activated"; tracking: string; destination: string | null }
  | { kind: "already"; tracking: string; status: string }
  | { kind: "error"; message: string };

export async function scanParcel(raw: string, shelf?: string): Promise<ScanResult> {
  const tracking = raw.trim().toUpperCase();
  if (!tracking) return { kind: "error", message: "Empty scan." };

  const sb = await createClient();
  const { data: { user } } = await sb.auth.getUser();
  if (!user) return { kind: "error", message: "Not signed in." };

  const { data: parcel } = await sb.from("parcels")
    .select("id,status,destination").eq("tracking_number", tracking).maybeSingle();

  if (!parcel) return { kind: "new", tracking };
  if (parcel.status !== "PENDING_ACTIVATION")
    return { kind: "already", tracking, status: parcel.status };

  const { error } = await sb.from("parcels")
    .update({ status: "ACTIVATED_AT_ORIGIN", shelf_location: shelf || null })
    .eq("id", parcel.id).eq("status", "PENDING_ACTIVATION"); // guards against double scans
  if (error) return { kind: "error", message: error.message };

  await sb.from("parcel_events").insert({
    parcel_id: parcel.id, event_type: "ACTIVATED", location: shelf || "Origin warehouse",
    scanned_by_user_id: user.id,
  });
  revalidatePath("/warehouse/intake");
  return { kind: "activated", tracking, destination: parcel.destination };
}

export type ActivateInput = {
  tracking: string;
  senderName: string; senderPhone: string;
  receiverName: string; receiverPhone: string; destination: string;
  weightLbs: number; length: number; width: number; height: number;
  shelf?: string;
};

export type LabelData = {
  tracking: string; senderName: string; senderPhone: string;
  receiverName: string; receiverPhone: string; destination: string;
  weightLbs: number; volumetric: number; chargeable: number; total: number;
  dims: string; shelf?: string; date: string;
};

export async function activateParcel(
  input: ActivateInput
): Promise<{ ok: true; label: LabelData } | { ok: false; message: string }> {
  const sb = await createClient();
  const { data: { user } } = await sb.auth.getUser();
  if (!user) return { ok: false, message: "Not signed in." };

  const nums = [input.weightLbs, input.length, input.width, input.height];
  if (nums.some((n) => !Number.isFinite(n) || n <= 0)) return { ok: false, message: "Enter weight and all dimensions." };
  if (!input.tracking || !input.senderName || !input.senderPhone || !input.receiverName || !input.destination)
    return { ok: false, message: "Fill in the required fields." };

  // Price is always computed on the server.
  const price = calcPricing(input);

  const { data: sender, error: cErr } = await sb.from("customers")
    .upsert({ full_name: input.senderName.trim(), phone: input.senderPhone.trim() }, { onConflict: "phone" })
    .select("id").single();
  if (cErr) return { ok: false, message: cErr.message };

  const { data: parcel, error: pErr } = await sb.from("parcels").insert({
    tracking_number: input.tracking, sender_id: sender.id,
    receiver_name: input.receiverName.trim(), receiver_phone: input.receiverPhone.trim(),
    destination: input.destination.trim(), weight_lbs: input.weightLbs,
    length: input.length, width: input.width, height: input.height,
    chargeable_weight: price.chargeable, total_cost: price.total,
    status: "ACTIVATED_AT_ORIGIN", shelf_location: input.shelf || null,
  }).select("id").single();
  if (pErr) return { ok: false, message: pErr.code === "23505" ? "This tracking number already exists." : pErr.message };

  await Promise.all([
    sb.from("parcel_events").insert({
      parcel_id: parcel.id, event_type: "ACTIVATED", location: input.shelf || "Origin warehouse",
      scanned_by_user_id: user.id,
    }),
    sb.from("invoices").insert({ parcel_id: parcel.id, amount: price.total }),
  ]);

  revalidatePath("/warehouse/intake");
  return {
    ok: true,
    label: {
      tracking: input.tracking, senderName: input.senderName, senderPhone: input.senderPhone,
      receiverName: input.receiverName, receiverPhone: input.receiverPhone, destination: input.destination,
      weightLbs: input.weightLbs, volumetric: price.volumetric, chargeable: price.chargeable, total: price.total,
      dims: `${input.length}x${input.width}x${input.height} in`, shelf: input.shelf,
      date: new Date().toLocaleDateString("en-US"),
    },
  };
}
