# Copy to .env.local (local) or set these in Render > Environment. Server-side only: never prefix them with NEXT_PUBLIC_ and never commit them.

# --- Database for the warehouse data (customers, receipts, shipments, ...) ---
# Any Postgres. With Supabase: Project Settings > Database > Connection string > "Transaction pooler" (port 6543), with your database password filled in.
# Leave empty to keep everything in memory (data is lost whenever the server restarts).
DATABASE_URL=
# Optional: set to 1 to verify the database's TLS certificate (needs NODE_EXTRA_CA_CERTS). Default: encrypted but not verified, which is what Supabase's pooler needs.
DATABASE_SSL_VERIFY=
# Optional: maximum database connections (default 4).
PG_POOL_MAX=

# --- Sign-in ---
# Everyone signs in with a name and a code (Administration > Users & access). The first administrator is created automatically:
# name jpsadmin1, code 4888 (change it right away: My account). ADMIN_NAME / ADMIN_CODE set a different first administrator.
ADMIN_NAME=
ADMIN_CODE=
# Secret that signs the sign-in cookie. Optional: when empty it is derived from DATABASE_URL / SUPABASE_SERVICE_ROLE_KEY.
AUTH_SECRET=

# --- Tracking website sync (optional) ---
# Leave both empty to run the warehouse app on its own (no website sync).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# The same Supabase project as the customer website. SUPABASE_SERVICE_ROLE_KEY takes the project's secret key (sb_secret_...) or the legacy service_role key.
# With them: customers who create an account on the website appear in Customers, pre-alerts and tracking statuses are shared.

# --- E-mail to customers (Administration > Email customers) ---
# E-mails go through the website's `admin-mail` function (Brevo). It checks a staff account of the website's admin panel (owner or agent):
SITE_STAFF_EMAIL=
SITE_STAFF_PASSWORD=
# Optional: the website's public anon key (the one in its index.html is used when empty).
SUPABASE_ANON_KEY=
